{
  "name": "@ghentcdh/annotated-text",
  "author": "GhentCDH",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/annotated-text",
    "directory": "libs/core"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "version": "1.3.0",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./annotated-text.css": "./index.css",
    "./style.css": "./index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.cjs",
    "*.d.ts",
    "*.css",
    "*.md",
    "assets/**",
    "lib/**"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@ghentcdh/w3c-utils": "^1.1.1",
    "d3-drag": "3.0.1",
    "d3-selection": "3.0.1",
    "lodash-es": "^4.17.21",
    "memoizee": "^0.4.17",
    "rbush": "4.0.1",
    "tokenizr": "2.2.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  }
}
