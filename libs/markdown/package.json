{
  "name": "@ghentcdh/annotated-text--markdown",
  "author": "GhentCDH",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhentCDH/annotated-text",
    "directory": "libs/markdown"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "version": "1.1.0",
  "type": "module",
  "main": "./index.umd.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "require": "./index.umd.cjs",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.cjs",
    "*.d.ts",
    "*.md",
    "lib/**"
  ],
  "sideEffects": false,
  "dependencies": {
    "markdown-it": "15.0.2",
    "memoizee": "^0.4.17",
    "uuid": "14.0.2",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@ghentcdh/annotated-text": "^1.0.3"
  }
}
