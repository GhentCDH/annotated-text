{
  "name": "markdown",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "markdown/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/libs/markdown"
      ],
      "options": {
        "config": "./vite.config.mts",
        "outDir": "../../dist/libs/markdown"
      },
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development"
        }
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/coverage/unit",
        "{workspaceRoot}/libs/coverage/markdown"
      ]
    }
  }
}
