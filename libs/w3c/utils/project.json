{
  "name": "w3c-utils",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/w3c/utils/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/libs/w3c/utils"
      ],
      "options": {
        "config": "./vite.config.mts",
        "outDir": "../../../dist/libs/w3c/utils"
      },
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development"
        }
      }
    },
    "test": {
      "outputs": [
        "{projectRoot}/coverage/unit",
        "{workspaceRoot}/libs/coverage/w3c/utils"
      ]
    }
  }
}
